{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--headless",
        "--browser",
        "chromium",
        "--isolated",
        "--allowed-origins",
        "http://localhost:*",
        "--output-dir",
        "/tmp/agy-playwright"
      ]
    }
  }
}
